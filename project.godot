; Engine configuration file.
; Voidwalker, moved from the browser one-shot (prototypes/voidwalker) to Godot 4.8 .NET.
; run/main_scene is set once the first scene exists (the port's hub scene).

config_version=5

[application]

config/name="Voidwalker"
config/features=PackedStringArray("4.8", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
